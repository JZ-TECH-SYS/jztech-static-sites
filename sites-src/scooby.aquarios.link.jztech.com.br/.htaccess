RewriteEngine On
# Redirecionar todas as solicitações que não são para arquivos físicos reais para index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

